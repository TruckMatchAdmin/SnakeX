# ==============================================================================
# SnakeX — Variables d'Environnement (Exemple de configuration)
# ==============================================================================
# IMPORTANT: Ne commitez jamais de clés secrètes ni de fichiers .env réels.
# Copiez ce fichier vers .env.local pour le développement local ou configurez
# les variables dans le service systemd / PM2 en production.

# ------------------------------------------------------------------------------
# 1. Supabase (Authentification & PostgreSQL)
# ------------------------------------------------------------------------------
# URL publique du projet Supabase (utilisée par le client mobile et le serveur)
EXPO_PUBLIC_SUPABASE_URL=https://<your-project-id>.supabase.co

# Clé anonyme publique (utilisée par le client mobile pour Auth & lectures publiques)
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Clé secrète de service (STRICTEMENT RÉSERVÉE au serveur de jeu Node.js, JAMAIS dans le mobile)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ------------------------------------------------------------------------------
# 2. Serveur de Jeu Multijoueur (Node.js & Socket.IO)
# ------------------------------------------------------------------------------
PORT=3001
NODE_ENV=development
LOG_LEVEL=info

# URL du serveur multijoueur pour l'application mobile Expo
# En dev local : http://localhost:3001 ou http://192.168.1.X:3001
# En production : https://vps-0af3084b.vps.ovh.net ou https://snakex.<your-domain>.com
EXPO_PUBLIC_SERVER_URL=http://localhost:3001

# Fréquence de simulation du moteur serveur (ticks par seconde)
TICK_RATE=30

# Clé d'API interne pour les métriques et administration sécurisée du serveur
SERVER_ADMIN_TOKEN=generate_a_secure_token_here

# ------------------------------------------------------------------------------
# 3. VPS OVH & Déploiement
# ------------------------------------------------------------------------------
VPS_HOST=152.228.137.4
VPS_USER=ubuntu
VPS_REMOTE_DIR=/var/www/snakex
